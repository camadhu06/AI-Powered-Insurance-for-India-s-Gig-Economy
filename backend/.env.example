# GigWare Backend Environment Configuration Example
# Do not commit real keys to version control.

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=gigware

# Server Configuration
PORT=5000

# Payment Gateway (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_example_key
RAZORPAY_KEY_SECRET=rzp_test_example_secret

# Internal Microservices (Docker Compose auto-injects this in production)
ML_SERVICE_URL=http://127.0.0.1:8000
